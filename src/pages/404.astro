---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Halaman tidak ditemukan">
  <section class="wrap section missing-page">
    <div class="missing-number" aria-hidden="true">
      404
    </div>
    <span class="eyebrow">404 / HALAMAN TIDAK DITEMUKAN</span>
    <h1>
      Mari kembali
      <br />
      ke arah yang tepat.
    </h1>
    <p>Halaman yang Anda cari tidak tersedia.</p>
    <a class="button" href="/">
      Kembali ke Beranda
    </a>
  </section>
</SiteLayout>
